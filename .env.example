# Local development: one complete URL. In Kubernetes the chart sets DB_HOST, DB_PORT, DB_NAME,
# DB_USER and DB_PASSWORD instead (see README).
DATABASE_URL=mysql+pymysql://module_service:change-me@localhost:3306/module_service?charset=utf8mb4
# TLS is on by default. Disable it only for a local MySQL without TLS.
MYSQL_SSL_DISABLED=true
# With TLS: CA file to verify the server certificate against, and whether to check the host name.
# MYSQL_SSL_CA=/path/to/ca-certificate.crt
# MYSQL_SSL_VERIFY_HOSTNAME=true
LOG_LEVEL=INFO
